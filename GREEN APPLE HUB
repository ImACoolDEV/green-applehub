local function setupLuckToggle(btn, gradKey, multiplier)
    safeBindClick(btn, function()
        Features[gradKey] = not Features[gradKey]
        if Features[gradKey] then
            btn.Text = btn.Text:gsub("OFF", "ON")
        else
            btn.Text = btn.Text:gsub("ON", "OFF")
        end
        local parentGrad = btn:FindFirstChildOfClass("UIGradient")
        if parentGrad then
            parentGrad.Color = Features[gradKey] and ON_GRAD or OFF_GRAD
        end
    end)
    
    table.insert(Tasks, task.spawn(function()
        while true do
            if Features[gradKey] then
                pcall(function()
                    LocalPlayer:SetAttribute("Luck", multiplier)
                    LocalPlayer:SetAttribute("LuckMultiplier", multiplier)
                end)
            end
            task.wait(0.5)
        end
    end))
end


    local btn = Instance.new("TextButton", parentPage)
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(28, 38, 28); btn.Text = text; btn.TextColor3 = Color3.fromRGB(255, 255, 255)
